---
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav class="wrap">
		<a class="brand" href="/" aria-label="Scolah Engineering home">
			<svg viewBox="0 0 61.14 60.34" width="28" height="28" aria-hidden="true">
				<path
					fill="var(--accent)"
					d="M47.73,0c-7.39,0-13.41,6.07-13.41,13.53v33.29c0,2.89-1.9,5.33-4.15,5.33s-4.14-2.44-4.14-5.33v-6.47c0-7.46-5.84-13.53-13.02-13.53S0,32.89,0,40.35v20h8.19v-20c0-2.94,2.16-5.33,4.82-5.33s4.82,2.39,4.82,5.33v2.48c0,1.32-.03,2.65-.03,3.97,0,4.040,1.78,8.11,4.86,10.75,2.09,1.77,4.75,2.8,7.5,2.8,6.8,0,12.34-6.07,12.34-13.53V13.53c0-2.94,2.34-5.33,5.22-5.33s5.21,2.39,5.21,5.33v46.82h8.19V13.53c0-7.46-6.01-13.53-13.41-13.53Z"
				></path>
				<path
					fill="var(--spark)"
					d="M19.73,12.05c0,4.43-3.59,8.02-8.02,8.02S3.69,16.48,3.69,12.05,7.28,4.03,11.71,4.03s8.02,3.59,8.02,8.02"
				></path>
			</svg>
			<span class="name">scolah</span>
			<span class="team">engineering</span>
		</a>
		<div class="links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/about/">About</HeaderLink>
			<a class="ext" href="https://scolah.com">scolah.com</a>
			<a class="gh" href="https://github.com/teamscolah" aria-label="Scolah on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: saturate(180%) blur(12px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}
	.name {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.3rem;
		color: var(--ink);
		letter-spacing: -0.02em;
	}
	.team {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		padding-left: 10px;
		border-left: 1px solid var(--line);
	}
	.links {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 0.92rem;
	}
	.links a {
		color: var(--ink-soft);
		text-decoration: none;
	}
	.links a:hover {
		color: var(--accent);
	}
	.gh {
		display: flex;
	}
	@media (max-width: 560px) {
		.team,
		.ext {
			display: none;
		}
		.links {
			gap: 16px;
		}
	}
</style>
