---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '../readingTime';
import FormattedDate from './FormattedDate.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
const { title, description, pubDate, heroImage, heroAlt, tags } = post.data;
---

<a class:list={['card', { featured }]} href={`/blog/${post.id}/`}>
	<div class="media">
		<Image src={heroImage} alt={heroAlt} width={featured ? 1100 : 720} height={featured ? 620 : 400} />
	</div>
	<div class="body">
		<span class="eyebrow">{tags[0]}</span>
		<h2>{title}</h2>
		<p class="desc">{description}</p>
		<p class="meta"><FormattedDate date={pubDate} /> · {readingTime(post.body)}</p>
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: inherit;
		gap: 1.1rem;
	}
	.media {
		overflow: hidden;
		border-radius: var(--radius);
		border: 1px solid var(--line);
		aspect-ratio: 16 / 9;
	}
	.media img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s ease;
	}
	.card:hover img {
		transform: scale(1.025);
	}
	h2 {
		margin: 0.35rem 0 0.5rem;
		font-size: 1.4rem;
	}
	.card:hover h2 {
		color: var(--accent);
	}
	.desc {
		margin: 0 0 0.7rem;
		font-size: 0.98rem;
		color: var(--ink-soft);
	}
	.meta {
		margin: 0;
		font-size: 0.8rem;
		color: var(--muted);
	}
	.featured {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		align-items: center;
		gap: 2.5rem;
	}
	.featured h2 {
		font-size: clamp(1.6rem, 3vw, 2.2rem);
	}
	.featured .desc {
		font-size: 1.05rem;
	}
	@media (max-width: 860px) {
		.featured {
			display: flex;
			gap: 1.1rem;
		}
	}
</style>
