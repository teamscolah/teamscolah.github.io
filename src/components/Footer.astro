---
const year = new Date().getFullYear();
---

<footer>
	<div class="wrap inner">
		<p>© {year} Scolah. Written by the people who build it.</p>
		<p class="links">
			<a href="https://scolah.com">scolah.com</a>
			<a href="https://docs.scolah.com">Docs</a>
			<a href="https://github.com/teamscolah">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 6rem;
		border-top: 1px solid var(--line);
		background: var(--bg-soft);
		font-size: 0.85rem;
		color: var(--muted);
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding-top: 2rem;
		padding-bottom: 2.5rem;
	}
	p {
		margin: 0;
	}
	.links {
		display: flex;
		gap: 1.2rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
</style>
